# Copy file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env ke GitHub!

PORT=3000

# Origin frontend yang diizinkan (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- AWS (opsional, kosongkan untuk development tanpa AWS) ---
AWS_REGION=ap-southeast-1

# Nama tabel DynamoDB (partition key: id, tipe String).
# Kosongkan -> backend pakai database in-memory
DYNAMODB_TABLE=

# Amazon Cognito (opsional, untuk login)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
